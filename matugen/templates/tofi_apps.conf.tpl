# --- Fuente y Estilo General ---
font = "FiraCode Nerd Font medium"
font-size = 13
hint-font = true

# --- Geometría (Centrado abajo, estilo Start Menu W11) ---
anchor = bottom
width = 700
height = 400
margin-bottom = 0

# --- Espaciado ---
padding-top = 16
padding-bottom = 0
padding-left = 14
padding-right = 14
result-spacing = 4
min-input-width = 360
num-results = 0

# --- Bordes ---
outline-width = 0
border-width = 2
corner-radius = 7
border-color = #{{colors.primary.default.hex_stripped}}33

# --- Prompt ---
prompt-text = " 󰍉  "
prompt-color = #{{colors.primary.default.hex_stripped}}aa
placeholder-text = "Buscar aplicaciones..."
placeholder-color = #{{colors.on_surface_variant.default.hex_stripped}}66

# --- Selección ---
selection-color = #{{colors.on_surface.default.hex_stripped}}ff
selection-background = #{{colors.surface_container_highest.default.hex_stripped}}cc
selection-background-padding = 5, 10
selection-match-color = #{{colors.tertiary.default.hex_stripped}}ff

# --- Colores ---
background-color = #{{colors.surface.default.hex_stripped}}e8
text-color = #{{colors.on_surface.default.hex_stripped}}dd

# --- Buscador ---
fuzzy-match = true
