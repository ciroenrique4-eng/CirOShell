# --- Fuente y Estilo General ---
font = "FiraCode Nerd Font"
font-size = 13
hint-font = true

# --- Geometría (Estilo Barra Central Compacta) ---
anchor = left
width = 20%
height = 30%
margin-left = 0

# --- Espaciado y Márgenes ---
padding-top = 20
padding-bottom = 20
padding-left = 10
padding-right = 25
result-spacing = 12
min-input-width = 120
num-results = 0

# --- Bordes ---
outline-width = 1
border-width = 2
corner-radius = 8
border-color = #{{colors.primary.default.hex_stripped}}ff

# --- Configuración del Prompt ---
prompt-text = " 󰍉  "
prompt-color = #{{colors.primary.default.hex_stripped}}ff
placeholder-text = "Buscar..."
placeholder-color = #{{colors.on_surface_variant.default.hex_stripped}}77

# --- Comportamiento de Selección ---
selection-color = #{{colors.primary.default.hex_stripped}}ff
selection-background = #{{colors.surface_container_highest.default.hex_stripped}}ff
selection-background-padding = 6, 12
selection-match-color = #{{colors.tertiary.default.hex_stripped}}ff

# --- Colores de Fondo y Texto General ---
background-color = #{{colors.surface.default.hex_stripped}}f2
text-color = #{{colors.on_surface.default.hex_stripped}}ee

# --- Buscador ---
fuzzy-match = true
